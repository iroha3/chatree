{
  "name": "chatree",
  "private": true,
  "version": "0.3.1",
  "engines": {
    "bun": ">=1.1.0"
  },
  "description": "Chatree — a local-first visual workspace for branching, comparing, and exporting LLM conversation trees.",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iroha3/chatree.git"
  },
  "homepage": "https://github.com/iroha3/chatree#readme",
  "bugs": {
    "url": "https://github.com/iroha3/chatree/issues"
  },
  "keywords": [
    "ai-chat",
    "branching-conversations",
    "conversation-tree",
    "llm",
    "local-first",
    "react-flow"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "icons": "bun scripts/make-icons.mjs",
    "test:edge": "bun tests/edge-contract-check.mjs",
    "test:usage": "bun tests/usage-check.mjs",
    "test:tree": "bun tests/tree-check.mjs",
    "test:smoke": "bun tests/smoke-check.mjs",
    "test:ux": "bun tests/node-ux-check.mjs",
    "desktop:build": "bun run build && bun scripts/pake.mjs",
    "desktop:build:fast": "bun run build && bun scripts/pake.mjs --iterative-build",
    "desktop:build:ci": "bun run build && bun scripts/pake.mjs --json"
  },
  "dependencies": {
    "dexie": "^3.2.4",
    "dexie-react-hooks": "^1.1.6",
    "gsap": "^3.12.5",
    "highlight.js": "^11.12.0",
    "katex": "^0.18.7",
    "lucide-react": "^0.344.0",
    "md-editor-rt": "^5.5.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "reactflow": "^11.10.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@tailwindcss/typography": "^0.5.16",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2"
  }
}
